// ===== HARD STOP: bank Pending / Link Generated cannot go to the next page =====
    try {

        if (target_screen.name === "Bank statement Details" || target_screen.api_name == "FSA" || target_screen.api_name == "GST_Transaction_Details") {
            var hs_rows = ZDK.Page.getField("Additional_banks_details").getValue() || [];
            for (var hs_i = 0; hs_i < hs_rows.length; hs_i++) {
                if (hs_rows[hs_i].Status === "Pending" || hs_rows[hs_i].Status === "Link Generated") {
                    ZDK.Client.hideLoader();
                    ZDK.Client.showAlert("A bank is still Pending or Link Generated. Please click  Performe Bank / Fetch  before moving to the next page.");
                    return false;
                }
            }
        }

    } catch (error) {
        ZDK.Apps.CRM.Functions.execute("client_script_assistance_error_message", {"triggered_from": "Error_Message", "param_map": encodeURI(JSON.stringify({"details": details, "error_message": error, "action_performed": "> Bank pending check"}))});
    }