string standalone.CSEL_NOVEL_REPORT_FETCH(String id)
{
dmp = Map();
dmp.put("From","Deluge Function");
dmp.put("Function Name","CSEL_NOVEL_REPORT_FETCH");
// Same duplicate-account rule as Perfios. Set true before go-live.
check_duplicate_accounts = true;
// Same values as in your Bank_details_update (Perfios) function - paste them once here
novel_service_org = "60023672997";
case_rejected_url = "https://crmsandbox.zoho.in/crm/uat1o/tab/Accounts/custom-view/564272000014078080/list";
try 
{
	// =====================================================
	// Load record
	// =====================================================
	bank = zoho.crm.getRecordById("Bank_Details",id);
	if(bank == null || bank.isEmpty())
	{
		return "Bank details record not found.";
	}
	failed_banks = List();
	failed_banks.addAll(ifnull(bank.get("Failed_Banks"),List()));
	loan_id = ifnull(ifnull(bank.get("Loan_Application"),Map()).get("id"),"");
	app_id = ifnull(ifnull(bank.get("Applicant"),Map()).get("id"),"");
	app_no = bank.get("Name");
	zoho.crm.updateRecord("Accounts",loan_id,{"ScoreCard_Flag":true});
	applicant = zoho.crm.getRecordById("Contacts",app_id);
	updateMap = Map();
	return_message = "";
	pan_failed = false;
	try 
	{
		bank_rec_status = ifnull(applicant.get("Bank_Details_Record_Status"),0);
		if(bank_rec_status.toLong() != 2)
		{
			zoho.crm.updateRecord("Contacts",app_id,{"Bank_Details_Record_ID":id,"Bank_Details_Record_Status":1});
		}
	}
	catch (error)
	{
		info error;
	}
	add_bank = ifnull(bank.get("Additional_banks_details"),List());
	// =====================================================
	// Novel requests of the bank rows that are waiting (status "Link Generated")
	// =====================================================
	pending_ids = List();
	for each  a in add_bank
	{
		if(ifnull(a.get("Status"),"").equalsIgnoreCase("Link Generated") && ifnull(a.get("Transaction_ID"),"") != "")
		{
			pending_ids.add(a.get("Transaction_ID"));
		}
	}
	info pending_ids;
	if(pending_ids.size() == 0)
	{
		// link was rejected / cancelled / expired - the Novel cancel flag tells us (read only, not set here)
		if(ifnull(bank.get("Novel_Cancelled"),false))
		{
			return "The Novel (Account Aggregator) verification was not completed. Please process the bank again to continue with the Perfios journey.";
		}
		return "No bank verification is waiting to be fetched.";
	}
	// =====================================================
	// Read the Novel links of the pending banks and decide what to do
	//   link Completed (Processed / Approved)      -> fetch the report
	//   link Failed (Rejected / Error / Expired)   -> tell the user why
	//   link Pending / In Progress                 -> ask the user to wait
	// =====================================================
	query = "select id,Request_Id,Novel_Doc_Id,Novel_Link_Status,Novel_Status,Novel_Expiry_Date from Logger where (Name='Novel Generate Link' and Applicant_ID='" + app_id + "') order by Created_Time desc limit 0,20";
	queryMap = Map();
	queryMap.put("select_query",query);
	resp = invokeurl
	[
		url :"https://www.zohoapis.in/crm/v8/coql"
		type :POST
		parameters:queryMap.toString()
		connection:"zohocrmall"
	];
	link_id = "";
	transaction_id = "";
	doc_id = "";
	wait_message = "";
	failed_message = "";
	if(resp != null && resp != "" && resp.containKey("data"))
	{
		for each  rec in resp.get("data")
		{
			if(!pending_ids.contains(rec.get("Request_Id")))
			{
				continue;
			}
			rec_link_status = ifnull(rec.get("Novel_Link_Status"),"");
			rec_status = ifnull(rec.get("Novel_Status"),"");
			// Error = our own Expire answered by Novel. It is stored as Completed, but there is no report - check it first
			if(rec_status.equalsIgnoreCase("Error"))
			{
				if(failed_message == "")
				{
					failed_message = "The Novel link was cancelled or has expired. Please click Process Bank again to generate a new link.";
				}
				continue;
			}
			if(rec_link_status == "Completed")
			{
				if(link_id == "")
				{
					link_id = rec.get("id");
					transaction_id = rec.get("Request_Id");
					doc_id = ifnull(rec.get("Novel_Doc_Id"),"");
				}
			}
			else if(rec_link_status == "Failed")
			{
				if(failed_message == "")
				{
					if(rec_status.equalsIgnoreCase("Rejected"))
					{
						failed_message = "The customer has rejected the consent of the AA. Please process the bank again to continue with the Perfios journey.";
					}
					else if(rec_status.equalsIgnoreCase("Expired"))
					{
						failed_message = "The Novel link was cancelled or has expired. Please click Process Bank again to generate a new link.";
					}
					else
					{
						failed_message = "The Account Aggregator verification could not be completed. Please process the bank again to continue with the Perfios journey.";
					}
				}
			}
			else
			{
				// Pending / In Progress / Approved: has the saved expiry time passed? (same rule as Generate)
				link_past_expiry = false;
				rec_expiry = ifnull(rec.get("Novel_Expiry_Date"),"").toString().trim();
				if(rec_expiry != "")
				{
					try 
					{
						rec_expiry_dt = rec_expiry.subString(0,16).toTime("yyyy-MM-dd HH:mm");
						if(zoho.currenttime.toLong() >= rec_expiry_dt.toLong())
						{
							link_past_expiry = true;
						}
					}
					catch (exp_err)
					{
						info "NOVEL - expiry check failed: " + exp_err;
					}
				}
				if(link_past_expiry)
				{
					if(failed_message == "")
					{
						failed_message = "The Novel link was cancelled or has expired. Please click Process Bank again to generate a new link.";
					}
				}
				else if(wait_message == "")
				{
					if(rec_status.equalsIgnoreCase("In Progress") || rec_status.equalsIgnoreCase("Approved"))
					{
						wait_message = "The customer has started the Account Aggregator journey. Please wait for the customer to complete it.";
					}
					else
					{
						wait_message = "Please wait for the customer to complete the bank verification.";
					}
				}
			}
		}
	}
	if(link_id == "")
	{
		// a newer link that is still open must not be blocked by an old failed one
		if(wait_message != "")
		{
			return wait_message;
		}
		if(failed_message != "")
		{
			return failed_message;
		}
		return "Please wait for the customer to complete the bank verification.";
	}
	if(doc_id == "")
	{
		return "Novel report not ready yet — docId not available.";
	}
	info "NOVEL - Request: " + transaction_id + " - Doc: " + doc_id + " - Logger: " + link_id;
	header_data = Map();
	// token
	get_api_domain_wso2 = zoho.crm.getOrgVariable("Local_Onprem_WSO2");
	get_api_domain_wso2_token = standalone.get_api_token(get_api_domain_wso2);
	novel_token = standalone.get_api_token("Novel");
	if(novel_token == "")
	{
		return "Novel token is not available. Please try again or contact the administrator.";
	}
	header_data.put("auth-token",novel_token);
	header_data.put("Authorization",get_api_domain_wso2_token);
	log_base = Map();
	log_base.put("Applicant",{"id":app_id});
	log_base.put("Loan_Application",{"id":loan_id});
	log_base.put("Loan_Application_ID",loan_id.toString());
	log_base.put("Applicant_ID",app_id.toString());
	log_base.put("Application_Number",app_no);
	log_base.put("Request_Id",transaction_id);
	log_base.put("Novel_Doc_Id",doc_id);
	// =====================================================
	// XML report - full request + response saved as one txt in the Logger
	// =====================================================
	xml_log = Map();
	xml_log.putAll(log_base);
	xml_log.put("API","Novel Report XML");
	xml_log.put("Name","Novel Report XML");
	xml_start = zoho.currenttime;
	xml_full = invokeurl
	[
		url :"https://" + get_api_domain_wso2 + ".chola.murugappa.com/cselperfiosnovelapi/1.0.0/api/downloadFileAsXml"
		type :POST
		body:doc_id
		headers:header_data
		detailed:true
	];
	xml_end = zoho.currenttime;
	if(xml_full == null)
	{
		xml_full = Map();
	}
	xml_code = ifnull(xml_full.get("responseCode"),"").toString();
	xml_resp = ifnull(xml_full.get("responseText"),"").toString();
	xml_log.put("Request_Time",xml_start);
	xml_log.put("Response_Time",xml_end);
	xml_audit_file = xml_resp.toFile("Novel XML API Request and Response.txt");
	xml_audit_file.setParamName("file");
	xml_audit_up = invokeurl
	[
		url :"https://www.zohoapis.in/crm/v8/files"
		type :POST
		files:xml_audit_file
		connection:"zohocrmall"
	];
	if(xml_audit_up != null && xml_audit_up.containKey("data"))
	{
		xml_log.put("API_Response_File",{{"file_id":xml_audit_up.get("data").get(0).get("details").get("id")}});
	}
	else
	{
		info "NOVEL - XML audit file upload failed: " + xml_audit_up;
	}
	if(xml_resp == "" || xml_code != "200")
	{
		xml_log.put("API_Call_Status","Failed");
		info zoho.crm.createRecord("Logger",xml_log);
		return "Novel Report XML fetch failed (status " + xml_code + ").";
	}
	if(xml_resp.contains("<downloadResponse"))
	{
		xml_log.put("API_Call_Status","Failed");
		info zoho.crm.createRecord("Logger",xml_log);
		return "Novel report is not available for download yet, or was already downloaded. Please try again later.";
	}
	xml_log.put("API_Call_Status","Success");
	info zoho.crm.createRecord("Logger",xml_log);
	xml_data = xml_resp.toXML();
	// =====================================================
	// Excel report (zip)
	// =====================================================
	excel_log = Map();
	excel_log.putAll(log_base);
	excel_log.put("API","Novel Report Excel");
	excel_log.put("Name","Novel Report Excel");
	excel_log.put("Request_Time",zoho.currenttime);
	excel_file = invokeurl
	[
		url :"https://" + get_api_domain_wso2 + ".chola.murugappa.com/cselperfiosnovelapi/1.0.0/api/downloadFileAsExcel"
		type :POST
		body:doc_id
		headers:header_data
	];
	excel_log.put("Response_Time",zoho.currenttime);
	if(excel_file == null || excel_file == "")
	{
		excel_log.put("API_Call_Status","Failed");
		info zoho.crm.createRecord("Logger",excel_log);
		return "Novel Report Excel fetch failed.";
	}
	excel_file.setParamName("file");
	excel_up = invokeurl
	[
		url :"https://www.zohoapis.in/crm/v8/files"
		type :POST
		files:excel_file
		connection:"zohocrmall"
	];
	info "NOVEL - Excel upload (Logger) response: " + excel_up;
	if(excel_up == null || !excel_up.containKey("data"))
	{
		excel_log.put("API_Call_Status","Failed");
		info zoho.crm.createRecord("Logger",excel_log);
		return "Novel Excel downloaded but Zoho file upload failed.";
	}
	excel_log.put("API_Response_File",{{"file_id":excel_up.get("data").get(0).get("details").get("id")}});
	excel_log.put("API_Call_Status","Success");
	info zoho.crm.createRecord("Logger",excel_log);
	// =====================================================
	// Pre-processing (one call)
	// =====================================================
	bank_list = List();
	dms_id = "";
	zfs_fileid = "";
	pre_fail = "";
	perfios_match_data = List();
	perfios_match_data.addAll(ifnull(bank.get("Perfios_Match_Details"),List()));
	try 
	{
		loan_type_map = {"Personal Loan":"PL"};
		type_of_app = applicant.get("Applicants_Type");
		emp_type_val = "";
		if(ifnull(type_of_app,"").equalsIgnoreCase("Applicant"))
		{
			emp_type_val = applicant.get("Applicant_Employment_Type");
		}
		else if(ifnull(type_of_app,"").equalsIgnoreCase("Co-Applicant"))
		{
			emp_type_val = applicant.get("Co_Applicant_Employment_Type");
		}
		else if(ifnull(type_of_app,"").equalsIgnoreCase("Guarantor"))
		{
			emp_type_val = applicant.get("Guarantor_Employment_Type");
		}
		if(ifnull(emp_type_val,"").equalsIgnoreCase("Salaried"))
		{
			emp_type_val = "SAL";
		}
		else
		{
			emp_type_val = "";
		}
		details = Map();
		details.put("data",xml_data);
		details.put("loan_type",loan_type_map.get(applicant.get("Loan_Type")));
		details.put("emp_type",emp_type_val);
		execute = Map();
		execute.put("consent_obtained",true);
		execute.put("details",details);
		lt = List();
		lt.add("execution_path");
		body = Map();
		body.put("data",execute);
		body.put("include",lt);
		header_data2 = Map();
		header_data2.put("X-SERVICE-NAME","ZohoCRM");
		header_data2.put("X-SERVICE-ORG",novel_service_org);
		pre_log = Map();
		pre_log.putAll(log_base);
		pre_log.put("API","Novel Pre-Processing");
		pre_log.put("Name","Novel Pre-Processing API");
		pre_log.put("Request_Time",zoho.currenttime);
		pre_resp = Map();
		pre_body = Map();
		pre_ok = false;
		// one call only (3 attempts made the fetch slow) - if it fails the user clicks Fetch again
		try 
		{
			pre_resp = invokeurl
			[
				url :"https://phonebridge.zoho.in/bfsibridge/v1/features/INSIGHTS/actions/pre_processing"
				type :POST
				parameters:body.toString()
				headers:header_data2
				connection:"bfsibridgeusingoauth"
				content-type:"application/json"
			];
			pre_data = ifnull(pre_resp.get("data"),Map());
			pre_status = ifnull(pre_data.get("execution_status"),"");
			pre_path = ifnull(pre_data.get("execution_path"),List());
			pre_body = Map();
			if(pre_path.size() > 0)
			{
				pre_body = ifnull(ifnull(pre_path.get(0).get("response"),Map()).get("response_body"),Map());
			}
			if(pre_status == "executed" && !isNull(pre_body.get("data")))
			{
				pre_ok = true;
			}
			else
			{
				if(pre_status == "")
				{
					pre_status = "no response";
				}
				pre_fail = "Pre-processing status: " + pre_status;
				info "NOVEL - Pre-processing failed: " + pre_resp;
			}
		}
		catch (e)
		{
			pre_fail = "Pre-processing error: " + e;
			info "NOVEL - Pre-processing error: " + e;
		}
		pre_log.put("Response_Time",zoho.currenttime);
		info "Pre-processing done. Success: " + pre_ok.toString();
		// 		pre_audit = "Success: " + pre_ok.toString() + "\n";
		// 		pre_audit = pre_audit + "Failure reason: " + pre_fail + "\n" + "\n";
		pre_audit = pre_resp.toString();
		pre_file = pre_audit.toFile("Novel Pre-Processing API.txt");
		pre_file.setParamName("file");
		pre_up = invokeurl
		[
			url :"https://www.zohoapis.in/crm/v8/files"
			type :POST
			files:pre_file
			connection:"zohocrmall"
		];
		if(pre_up != null && pre_up.containKey("data"))
		{
			pre_log.put("API_Response_File",{{"file_id":pre_up.get("data").get(0).get("details").get("id")}});
		}
		else
		{
			info "NOVEL - Pre-processing audit upload failed: " + pre_up;
		}
		if(pre_ok)
		{
			pre_log.put("API_Call_Status","Success");
			bank_resp = pre_body;
			dms_id = ifnull(bank_resp.get("dms_id"),"");
			// Account Analysis document (same as Perfios)
			try 
			{
				if(dms_id != "")
				{
					zfs_fileid = standalone.CSEL_DMS_GET_DOCUMENT(dms_id,"Bank",loan_id,"json");
					if(zfs_fileid == "zfs_resp failed")
					{
						zfs_fileid = standalone.CSEL_DMS_GET_DOCUMENT(dms_id,"Bank",loan_id,"json");
					}
				}
				info "NOVEL - DMS id: " + dms_id + " - Account Analysis file: " + zfs_fileid;
			}
			catch (e)
			{
				info "NOVEL - DMS document error: " + e;
			}
			// ----- Name / email / mobile / PAN / address cross-verification (same as Perfios: Credit Journey and DDE) -----
			try 
			{
				email = "";
				panno = "";
				mobile = "";
				name = "";
				emp_type = "";
				perfios_app_type = "";
				if(applicant.get("Applicants_Type") == "Applicant")
				{
					email = applicant.get("Primary_Applicant_Email");
					panno = applicant.get("Applicant_PAN_No");
					mobile = applicant.get("Primary_Applicant_Phone");
					name = applicant.get("Applicant_Name");
					emp_type = applicant.get("Applicant_Employment_Type");
					perfios_app_type = "Primary Applicant";
				}
				else if(applicant.get("Applicants_Type") == "Co-applicant")
				{
					email = applicant.get("Personal_Email_ID");
					panno = applicant.get("Co_App_PAN_No");
					mobile = applicant.get("Mobile_No");
					name = applicant.get("Co_Applicant_Name");
					emp_type = applicant.get("Co_Applicant_Employment_Type");
					perfios_app_type = "Financial Co-applicant";
				}
				app_stage_now = ifnull(applicant.get("Application_Stage"),"");
				is_credit = app_stage_now.equalsIgnoreCase("Credit Journey");
				if(is_credit || app_stage_now.equalsIgnoreCase("DDE"))
				{
					// red flags exist only in the Credit Journey (Overall_Eligibility); DDE only fills the match details and the PAN reject
					redflags = List();
					existing_flags = List();
					recommendation = Map();
					if(is_credit)
					{
						recommendation = zoho.crm.getRelatedRecords("Overall_Eligibility","Accounts",applicant.get("Account_Name").get("id"));
						recommendation = zoho.crm.getRecordById("Overall_Eligibility",recommendation.get(0).get("id"));
						redflags = ifnull(recommendation.get("Red_Flag"),List());
						// red flags this applicant already has (a repeated fetch does not add them again - same as Perfios)
						for each  flag in redflags
						{
							if(ifnull(flag.get("Applicant_Name"),Map()).get("id") == applicant.get("id"))
							{
								existing_flags.add(ifnull(flag.get("Condition"),"").toString());
							}
						}
					}
					create_reject_record = true;
					for each  link in bank_resp.get("data")
					{
						redflag_data = link.get("statements");
						if(is_credit)
						{
							// ---- Name similarity: account holder vs LOS name
							bank_primaryHolder = ifnull(link.get("primaryHolder"),"").replaceAll("M/S.","");
							name_log = Map();
							name_log.put("Request_Time",zoho.currenttime);
							name_resp = standalone.namesimilarity(bank_primaryHolder,name,loan_id);
							name_log.put("Response_Time",zoho.currenttime);
							name_log.put("API","Account Name Match");
							name_log.put("Name","Account Name Match");
							name_log.put("Response",name_resp);
							name_log.put("Loan_Application",{"id":applicant.get("Account_Name").get("id")});
							name_log.put("Loan_Application_ID",applicant.get("Account_Name").get("id").toString());
							name_log.put("Applicant",{"id":applicant.get("id")});
							name_log.put("Applicant_ID",applicant.get("id").toString());
							name_log.put("Module_Name","Applicants");
							name_log.put("Module_API_Name","Contacts");
							if(name_resp.get("data").get("execution_status") == "executed")
							{
								name_log.put("API_Call_Status","Success");
								name_log.put("Time_Taken",(name_resp.get("data").get("execution_path").get(0).get("time_taken") / 1000).toString() + " secs");
								score = name_resp.get("data").get("execution_path").get(0).get("response").get("response_body").get("result").get("score");
								score_round = (score * 100).round(2);
								if(score_round < 85 && !existing_flags.contains("Perfios Name Match"))
								{
									redflag = Map();
									redflag.put("Applicant_Name",{"id":applicant.get("id")});
									redflag.put("Applicant_type",applicant.get("Applicants_Type"));
									redflag.put("Condition","Perfios Name Match");
									redflag.put("Output","LOS Full Name is " + name + " and Novel Banking Account holder name is " + bank_primaryHolder + " for " + link.get("bankName") + " account number " + link.get("accNo") + ". Kindly verify the name mismatch on banking page.");
									redflags.add(redflag);
									existing_flags.add("Perfios Name Match");
								}
							}
							else
							{
								name_log.put("API_Call_Status","Failed");
							}
							info zoho.crm.createRecord("Logger",name_log);
						}
						for each  acc in redflag_data
						{
							acc_email = ifnull(acc.get("email"),"").toString();
							acc_mobile = ifnull(acc.get("mobile"),"").toString();
							acc_pan = ifnull(acc.get("pan"),"").toString();
							perfios_match_row = Map();
							perfios_match_row.put("Applicant_Type",perfios_app_type);
							perfios_match_row.put("Bank_Account_No",link.get("accNo"));
							perfios_match_row.put("Bank_Name",link.get("bankName"));
							// ---- Email
							perfios_match_row.put("Email_id_Perfios",acc.get("email"));
							if(acc_email != "" && !ifnull(email,"").equalsIgnoreCase(acc_email))
							{
								perfios_match_row.put("Email_ID_Match","Not match");
								if(is_credit && !existing_flags.contains("Perfios Email Match"))
								{
									redflag = Map();
									redflag.put("Applicant_Name",{"id":applicant.get("id")});
									redflag.put("Applicant_type",applicant.get("Applicants_Type"));
									redflag.put("Condition","Perfios Email Match");
									redflag.put("Output","In LOS the Email ID was captured as " + email + " and in Novel " + link.get("statementType") + " response is " + acc_email + ". Kindly verify the same.");
									redflags.add(redflag);
									existing_flags.add("Perfios Email Match");
								}
							}
							else if(acc_email != "")
							{
								perfios_match_row.put("Email_ID_Match","Match");
							}
							else
							{
								perfios_match_row.put("Email_ID_Match","NA");
							}
							// ---- Mobile
							perfios_match_row.put("Mobile_No_Perfios",acc.get("mobile"));
							if(acc_mobile != "" && !ifnull(mobile,"").equalsIgnoreCase(acc_mobile))
							{
								perfios_match_row.put("Mobile_Number_Match","Not match");
								if(is_credit && !existing_flags.contains("Perfios Mobile Match"))
								{
									redflag = Map();
									redflag.put("Applicant_Name",{"id":applicant.get("id")});
									redflag.put("Applicant_type",applicant.get("Applicants_Type"));
									redflag.put("Condition","Perfios Mobile Match");
									redflag.put("Output","In LOS the mobile number is captured as " + mobile + " where as in Novel mobile number used in " + link.get("statementType") + " is " + acc_mobile + ". Kindly verify the same.");
									redflags.add(redflag);
									existing_flags.add("Perfios Mobile Match");
								}
							}
							else if(acc_mobile != "")
							{
								perfios_match_row.put("Mobile_Number_Match","Match");
							}
							else
							{
								perfios_match_row.put("Mobile_Number_Match","NA");
							}
							// ---- PAN: reject record + Failed Banks + Bank_Failed (same as Perfios)
							perfios_match_row.put("Pan_No_Perfios",acc.get("pan"));
							if(acc_pan != "" && !ifnull(panno,"").equalsIgnoreCase(acc_pan))
							{
								perfios_match_row.put("Pan_Match","Not match");
								reject_comments = "Pan no. as per Novel is " + acc_pan + " whereas LOS PAN No. is " + panno + ". Hence can't be processed.";
								pan_account_no = ifnull(acc.get("accountNo"),link.get("accNo"));
								if(create_reject_record)
								{
									details_map = Map();
									details_map.put("app",applicant.get("id"));
									details_map.put("los_PAN",panno);
									details_map.put("PAN",acc_pan);
									details_map.put("acct_no",pan_account_no);
									details_map.put("Bank_Name",link.get("bankName"));
									details_map.put("holder_name",link.get("primaryHolder"));
									response_rejected = invokeurl
									[
										url :"https://www.zohoapis.in/crm/v8/functions/reject_record_create2/actions/execute?auth_type=oauth&loan_id=" + applicant.get("Account_Name").get("id") + "&type_of_rejection=Perfios_pan_mismatch&rules=REJPANNOMATCH&app_stage_loan=" + applicant.get("Application_Stage") + "&bankDetails=" + details_map.toString() + "&reject_comments=" + reject_comments
										type :POST
										connection:"zohocrmall"
									];
									info "NOVEL - PAN mismatch reject record: " + response_rejected;
									create_reject_record = false;
									return_message = reject_comments;
								}
								// the account goes to Failed Banks (after the reject record, so that is never affected)
								failed_bank_load = false;
								for each  failed in failed_banks
								{
									if(pan_account_no == failed.get("Account_Number") && ifnull(failed.get("Reason_for_failure"),"") == reject_comments)
									{
										failed_bank_load = true;
									}
								}
								if(!failed_bank_load)
								{
									failed_banks.add({"Account_Holder_Name":link.get("primaryHolder"),"Bank_Name":link.get("bankName"),"Account_Number":pan_account_no,"Statement_Type":link.get("statementType"),"Reason_for_failure":reject_comments});
								}
								pan_failed = true;
							}
							else if(acc_pan != "")
							{
								perfios_match_row.put("Pan_Match","Match");
							}
							else
							{
								perfios_match_row.put("Pan_Match","NA");
							}
							// ---- Address: statement address vs LOS communication address (Novel is Personal Loan + Salaried)
							addr1 = ifnull(acc.get("address"),"").toString();
							perfios_match_row.put("Address_Match","NA");
							if(addr1 != "" && ifnull(emp_type,"").equalsIgnoreCase("Salaried"))
							{
								try 
								{
									los_addr = applicant.get("Communication_House_Flat_Shop_Unit_No") + ", " + applicant.get("Communication_Address_Line1") + ", " + applicant.get("Communication_Address_Line2") + ", " + applicant.get("Communication_Area_of_Locality") + ", " + applicant.get("Communication_Landmark") + ", " + applicant.get("Communication_City") + ", " + applicant.get("Communication_District") + ", " + applicant.get("Communication_State_UT") + ", " + applicant.get("Communication_Country") + ", " + applicant.get("CA_Pincode").get("name");
									addr_log = Map();
									addr_log.put("Request_Time",zoho.currenttime);
									addr_resp = standalone.AddressMatchAPI(addr1,los_addr,loan_id);
									addr_log.put("Response_Time",zoho.currenttime);
									addr_log.put("API","Address Match");
									addr_log.put("Name","Address Match");
									addr_log.put("Response",addr_resp);
									addr_log.put("Application_Number",applicant.get("LAN_NO"));
									addr_log.put("Loan_Application",{"id":applicant.get("Account_Name").get("id")});
									addr_log.put("Loan_Application_ID",applicant.get("Account_Name").get("id").toString());
									addr_log.put("Applicant",{"id":applicant.get("id")});
									addr_log.put("Applicant_ID",applicant.get("id").toString());
									addr_log.put("Module_Name","Applicants");
									addr_log.put("Module_API_Name","Contacts");
									if(addr_resp.get("data").get("execution_status") == "executed")
									{
										addr_log.put("API_Call_Status","Success");
										addr_log.put("Time_Taken",(addr_resp.get("data").get("execution_path").get(0).get("time_taken") / 1000).toString() + " secs");
										addr_score = (addr_resp.get("data").get("result").get("score") * 100).round(2);
										perfios_match_row.put("Addresss_Perfios",addr1);
										if(addr_score < 85)
										{
											perfios_match_row.put("Address_Match","Not Match");
											if(is_credit && !existing_flags.contains("Perfios Address Match"))
											{
												redflag = Map();
												redflag.put("Applicant_Name",{"id":applicant.get("id")});
												redflag.put("Applicant_type",applicant.get("Applicants_Type"));
												redflag.put("Condition","Perfios Address Match");
												redflag.put("Output","In LOS " + los_addr + " communication address mismatch against Novel fetched address " + addr1 + " for SB account no. " + ifnull(acc.get("accountNo"),link.get("accNo")) + ". kindly verify the same.");
												redflags.add(redflag);
												existing_flags.add("Perfios Address Match");
											}
										}
										else
										{
											perfios_match_row.put("Address_Match","Match");
										}
									}
									else
									{
										addr_log.put("API_Call_Status","Failed");
									}
									if(is_credit)
									{
										info zoho.crm.createRecord("Logger",addr_log);
									}
								}
								catch (addr_err)
								{
									info "NOVEL - Address match error: " + addr_err;
								}
							}
							// ---- keep one match row per account + PAN (a repeated fetch does not add it again - same as Perfios)
							match_row_exists = false;
							for each  row_pm in perfios_match_data
							{
								if(row_pm.get("Bank_Account_No") == perfios_match_row.get("Bank_Account_No") && ifnull(row_pm.get("Pan_No_Perfios"),"") == ifnull(perfios_match_row.get("Pan_No_Perfios"),""))
								{
									match_row_exists = true;
								}
							}
							if(!match_row_exists)
							{
								perfios_match_data.add(perfios_match_row);
							}
						}
					}
					if(is_credit)
					{
						// one red flag per applicant + condition + text, with Condition2 (same as Perfios)
						unique_flags = List();
						unique_keys = List();
						for each  flag_item in redflags
						{
							flag_applicant_id = "";
							if(flag_item.get("Applicant_Name") != null)
							{
								flag_applicant_id = ifnull(flag_item.get("Applicant_Name").get("id"),"").toString();
							}
							flag_condition = ifnull(flag_item.get("Condition"),"").toString();
							flag_key = flag_applicant_id + "||" + flag_condition.trim().toLowerCase() + "||" + ifnull(flag_item.get("Output"),"").toString().trim().toLowerCase();
							if(!unique_keys.contains(flag_key))
							{
								unique_keys.add(flag_key);
								flag_item.put("Condition2",flag_condition);
								unique_flags.add(flag_item);
							}
						}
						info zoho.crm.updateRecord("Overall_Eligibility",recommendation.get("id"),{"Red_Flag":unique_flags});
					}
				}
				updateMap.put("Perfios_Match_Details",perfios_match_data);
			}
			catch (e)
			{
				info "NOVEL - Cross-verification error: " + e;
			}
			// ----- Build the account list -----
			for each  bank_row in bank_resp.get("data")
			{
				if(isNull(bank_row.get("accNo")))
				{
					if(!ifnull(return_message,"").contains("Pan no. as per Novel is"))
					{
						return "Bank Account No is empty from Novel Pre-processing";
					}
					return return_message;
				}
				bank_map = Map();
				bank_map.put("bank",bank_row.get("bankName"));
				bank_map.put("name",bank_row.get("primaryHolder"));
				bank_map.put("accno",bank_row.get("accNo"));
				bank_map.put("acctype",bank_row.get("accType"));
				bank_map.put("Average_salary",ifnull(bank_row.get("averageSalaries"),"").toString());
				bank_map.put("Statement_Type",bank_row.get("statementType"));
				bank_map.put("Statements",bank_row.get("statements"));
				bank_statements = ifnull(bank_row.get("statements"),List());
				if(bank_statements.size() > 0)
				{
					bank_map.put("Reasons",bank_statements.get(0).get("reason"));
				}
				averageBankBalance = "";
				try 
				{
					averageBankBalance = bank_row.get("averageBankBalance").toDecimal().round(0).toString();
				}
				catch (e)
				{
					info "NOVEL - averageBankBalance error: " + e;
				}
				bank_map.put("ABB_CA_SB",averageBankBalance);
				emiServiced = "";
				try 
				{
					emiServiced = bank_row.get("emiServiced").toDecimal().round(0).toString();
				}
				catch (e)
				{
					info "NOVEL - emiServiced error: " + e;
				}
				bank_map.put("EMI_as_per_banking",emiServiced);
				bank_map.put("Inward_Cheque_return_last_6M",ifnull(bank_row.get("inwardChqBounceCount"),"").toString());
				bank_map.put("totalCredits",bank_row.get("totalCredits"));
				bank_map.put("Annual_Banking_Credits",bank_row.get("annualbankingcredits"));
				bank_map.put("totalEmiOrLoan",bank_row.get("totalEmi"));
				bank_map.put("Sanction_limit",bank_row.get("sanctionLimit"));
				bank_map.put("Avg_utilization_OD_CC",bank_row.get("avgUtilization"));
				bank_map.put("IFSC_Code",bank_row.get("ifsc"));
				bank_map.put("bounces_4m_6m",ifnull(bank_row.get("bounces_4m_6m"),"").toString());
				bank_map.put("bounces_0m_3m",ifnull(bank_row.get("bounces_0m_3m"),"").toString());
				bank_map.put("inwardBounceCount",ifnull(bank_row.get("inwardBounceCount"),"").toString());
				bank_map.put("chqIssuesCount",ifnull(bank_row.get("chqIssuesCount"),"").toString());
				bank_map.put("outwardBounceCount",ifnull(bank_row.get("outwardBounceCount"),"").toString());
				bank_map.put("chqDepositsCount",ifnull(bank_row.get("chqDepositsCount"),"").toString());
				bank_map.put("start_date",bank_row.get("xnsStartDate"));
				bank_map.put("end_date",bank_row.get("xnsEndDate"));
				bank_map.put("countCredits",bank_row.get("countCredits"));
				bank_map.put("countDebits",bank_row.get("countDebits"));
				mon_year_list = List();
				// the bank row the user entered for this request (Duration_Months + OD/CC sanction limit / drawing power)
				sl_dp = "";
				sl_dp_json = Map();
				for each  s in ifnull(bank.get("SL_DP_Data"),List())
				{
					if(s.get("Bank_Account_Number") == bank_row.get("accNo") && transaction_id == s.get("Transaction_ID"))
					{
						sl_dp = ifnull(s.get("Duration_Months"),"");
						sl_dp_json = s;
					}
				}
				sl_dp_list = sl_dp.toString().toList(",");
				for each  m_y in bank_row.get("consolidateData")
				{
					mon_year = Map();
					mon_year.put("A_C_No",bank_row.get("accNo"));
					mon_year.put("Perfios_Account_Number",bank_row.get("accNo"));
					mon_year.put("ABB_CA_SB",ifnull(m_y.get("balAvg"),"0"));
					mon_year.put("Average_Utilization_Value",ifnull(m_y.get("avgNegEOD"),"0"));
					mon_year.put("Minimum_Utilization_Value",ifnull(m_y.get("balMinNeg"),"0"));
					mon_year.put("Maximum_Utilization_Value",ifnull(m_y.get("balMin"),"0"));
					mon_year.put("Avg_utilization_OD_CC",ifnull(m_y.get("avgUtilization"),"0").toString());
					mon_year.put("Drawing_Power",ifnull(m_y.get("dpLimit"),"0").toString());
					mon_year.put("EMI_bounces_in_last_6_months",m_y.get("emiBounces"));
					mon_year.put("Interest_Service_delay",ifnull(m_y.get("intPayDelay"),"0"));
					mon_year.put("Maximum_Utilization",ifnull(m_y.get("maximumUtilization"),"0"));
					mon_year.put("Minimum_Utilization",ifnull(m_y.get("minimumUtilization"),"0"));
					// Month_Year: "Jul-2026" -> "Jul-26"
					my_raw = ifnull(m_y.get("monthYear"),"").toString();
					my_parts = my_raw.toList("-");
					if(my_parts.size() == 2 && my_parts.get(1).length() == 4)
					{
						my_raw = my_parts.get(0) + "-" + my_parts.get(1).subString(2);
					}
					mon_year.put("Month_Year",my_raw);
					selected_index = 1;
					sl_index = 1;
					for each  sl in sl_dp_list
					{
						if(sl.trim() == my_raw)
						{
							selected_index = sl_index;
						}
						sl_index = sl_index + 1;
					}
					mon_year.put("dpLimit_UI",sl_dp_json.get("Drawing_Power_OD_CC_Month" + selected_index));
					mon_year.put("snLimit_UI",sl_dp_json.get("Sanction_Limit_OD_CC_Month" + selected_index));
					mon_year.put("No_of_Inward_cheque",m_y.get("inwChqCount"));
					mon_year.put("No_of_Outward_cheque",m_y.get("outwChqCount"));
					mon_year.put("No_of_EMIs",m_y.get("totalEmiLoanCount"));
					mon_year.put("Overdrawn_days",ifnull(m_y.get("overdrawnDays"),"0"));
					mon_year.put("Penal_Charges",ifnull(m_y.get("penalCharges"),"0"));
					mon_year.put("Sanction_limit",ifnull(m_y.get("snLimit"),"0"));
					mon_year.put("Total_EMI_Amount",m_y.get("totalEmiLoanAmount"));
					mon_year.put("Transaction_Counts_Credit",m_y.get("creditsCount"));
					mon_year.put("Transaction_Counts_Debit",m_y.get("debitsCount"));
					mon_year.put("Value_Summation_Credits",m_y.get("creditsSum"));
					mon_year.put("Value_Summation_Debits",m_y.get("debitsSum"));
					mon_year_list.add(mon_year);
				}
				bank_map.put("Monthly_transactions_details",mon_year_list.toString());
				fcu_status = "";
				fcu = bank_row.get("FCUstatus");
				if(fcu != null && fcu != "")
				{
					try 
					{
						fcu = fcu.toMap();
						if(!isNull(fcu.get("PossibleFraudIndicators")) && !isText(fcu.get("PossibleFraudIndicators").get(0)))
						{
							fcu_status = fcu.get("PossibleFraudIndicators").get(0).get("SuspiciousBankEStatements").get(0).get("$").get("status");
						}
					}
					catch (e)
					{
						info "NOVEL - FCU status error: " + e;
					}
				}
				bank_map.put("FCU_status",fcu_status.toString());
				bank_map.put("FCU_Statements",ifnull(bank_row.get("statementStatus"),"").toString());
				info "NOVEL - Account read: " + bank_map.get("bank") + " / " + bank_map.get("accno") + " / months: " + mon_year_list.size();
				bank_list.add(bank_map);
			}
		}
		else
		{
			pre_log.put("API_Call_Status","Failed");
		}
		info zoho.crm.createRecord("Logger",pre_log);
	}
	catch (error)
	{
		pre_fail = "Error: " + error;
		info "NOVEL - Issue while processing the Pre-Processing: " + error;
	}
	if(bank_list.size() == 0)
	{
		if(pre_fail == "")
		{
			pre_fail = "No account found in the Novel response.";
		}
		info "NOVEL - Pre-processing failed: " + pre_fail;
		info zoho.crm.updateRecord("Logger",link_id,{"Perfios_Status":"Failed"});
		return "Preprocessing API Failed. " + pre_fail;
	}
	// =====================================================
	// Existing accounts (only when the duplicate check is on)
	// =====================================================
	all_app_banks = List();
	if(check_duplicate_accounts)
	{
		try 
		{
			bank_rel = zoho.crm.getRelatedRecords("Bank_Details","Accounts",loan_id);
			for each  each_bank in bank_rel
			{
				bank_each = zoho.crm.getRecordById("Bank_Details",each_bank.get("id"));
				if(!isNull(bank_each.get("Bank_account")) && bank_each.get("Bank_account").size() > 0)
				{
					all_app_banks.addAll(bank_each.get("Bank_account"));
				}
			}
			bank_draf_rel = zoho.crm.getRelatedRecords("Bank_Details","Accounts",loan_id,1,200,{"state":"draft"});
			for each  each_bank in bank_draf_rel
			{
				bank_each = zoho.crm.getRecordById("Bank_Details",each_bank.get("id"));
				if(!isNull(bank_each.get("Bank_account")) && bank_each.get("Bank_account").size() > 0)
				{
					all_app_banks.addAll(bank_each.get("Bank_account"));
				}
			}
		}
		catch (e)
		{
			info "NOVEL - Duplicate check error: " + e;
		}
	}
	// =====================================================
	// Build the NEW subform rows
	// =====================================================
	new_rows = List();
	failed_flag = false;
	for each  m in bank_list
	{
		if(m.get("name") == "" || m.get("name") == null)
		{
			failed_banks.add({"Account_Holder_Name":m.get("name"),"Account_Number":m.get("accno"),"Bank_Name":m.get("bank"),"Reason_for_failure":"Account holder name contains null, special character"});
			failed_flag = true;
			if(bank_list.size() == 1 && !ifnull(return_message,"").contains("Pan no. as per Novel is"))
			{
				return_message = "Account holder name should not contain null, special character.";
			}
			continue;
		}
		dup_flag = false;
		for each  bank_da in all_app_banks
		{
			if(m.get("accno") == bank_da.get("Account_Number") && m.get("bank") == bank_da.get("Bank_Name"))
			{
				dup_flag = true;
			}
		}
		if(dup_flag)
		{
			failed_banks.add({"Account_Holder_Name":m.get("name"),"Account_Number":m.get("accno"),"Bank_Name":m.get("bank"),"Reason_for_failure":"Duplicate Account Number"});
			failed_flag = true;
			if(bank_list.size() == 1 && !ifnull(return_message,"").contains("Pan no. as per Novel is"))
			{
				return_message = "Duplicate account number [" + m.get("accno") + "], Bank Name " + m.get("bank") + " is not allowed";
			}
			continue;
		}
		account_type = ifnull(m.get("acctype"),"");
		try 
		{
			query = "select Los_Account_Type from Masters where (Perfios_Account_Type='" + account_type + "' and Master_for='Account Type')";
			queryMap = Map();
			queryMap.put("select_query",query);
			master_search = invokeurl
			[
				url :"https://www.zohoapis.in/crm/v8/coql"
				type :POST
				parameters:queryMap.toString()
				connection:"zohocrmall"
			];
			if(master_search != null && master_search != "" && master_search.get("data").size() > 0)
			{
				account_type = master_search.get("data").get(0).get("Los_Account_Type");
			}
		}
		catch (error)
		{
			info "NOVEL - Account type lookup error: " + error;
		}
		ba = Map();
		ba.put("Account_Number",m.get("accno"));
		ba.put("Perfios_Account_Number",m.get("accno"));
		ba.put("Bank_Name",m.get("bank"));
		ba.put("Name_of_the_Account_Holder",m.get("name"));
		ba.put("Type_of_Account",account_type);
		ba.put("Average_salary",m.get("Average_salary").toString());
		ba.put("ABB_CA_SB",m.get("ABB_CA_SB"));
		ba.put("totalCredits",m.get("totalCredits"));
		ba.put("Novel_Doc_Id",doc_id);
		ba.put("Annual_Banking_Credits",m.get("Annual_Banking_Credits"));
		ba.put("totalEmiOrLoan",m.get("totalEmiOrLoan"));
		ba.put("Sanction_limit",m.get("Sanction_limit"));
		ba.put("Avg_utilization_OD_CC",m.get("Avg_utilization_OD_CC"));
		ba.put("IFSC_Code",m.get("IFSC_Code"));
		ba.put("bounces_4m_6m",m.get("bounces_4m_6m").toString());
		ba.put("bounces_0m_3m",m.get("bounces_0m_3m").toString());
		ba.put("inwardBounceCount",m.get("inwardBounceCount").toString());
		ba.put("chqIssuesCount",m.get("chqIssuesCount").toString());
		ba.put("outwardBounceCount",m.get("outwardBounceCount").toString());
		ba.put("chqDepositsCount",m.get("chqDepositsCount").toString());
		ba.put("FCU_status",m.get("FCU_status").toString());
		ba.put("FCU_Statements",m.get("FCU_Statements").toString());
		ba.put("Monthly_transactions_details",m.get("Monthly_transactions_details"));
		if(m.get("EMI_as_per_banking") != "")
		{
			ba.put("EMI_as_per_banking",m.get("EMI_as_per_banking"));
		}
		if(m.get("Inward_Cheque_return_last_6M") != "")
		{
			ba.put("Inward_Cheque_return_last_6M",m.get("Inward_Cheque_return_last_6M"));
		}
		// Dates: dd/MM/yyyy -> yyyy-MM-dd
		// 		start_date_val = ifnull(m.get("start_date"),"");
		// 		if(start_date_val != "")
		// 		{
		// 			start_date_val = start_date_val.toDate("dd/MM/yyyy").toString("yyyy-MM-dd");
		// 		}              
		ba.put("Start_Date",m.get("start_date"));
		// 		end_date_val = ifnull(m.get("end_date"),"");
		// 		if(end_date_val != "")
		// 		{
		// 			end_date_val = end_date_val.toDate("dd/MM/yyyy").toString("yyyy-MM-dd");
		// 		}
		ba.put("End_Date",m.get("end_date"));
		ba.put("countCredits",m.get("countCredits"));
		ba.put("countDebits",m.get("countDebits"));
		ba.put("Transaction_ID",transaction_id.toString());
		ba.put("Statement_Type",m.get("Statement_Type"));
		ba.put("Statements",m.get("Statements"));
		ba.put("Reasons",m.get("Reasons"));
		ba.put("Bank_flag",true);
		// ----- Reports in the subform: only the Novel Excel zip (the XML stays in the Logger only) -----
		// Perfios_Report = Novel Excel zip
		up_report = invokeurl
		[
			url :"https://www.zohoapis.in/crm/v8/files"
			type :POST
			files:excel_file
			connection:"zohocrmall"
		];
		// Perfios_EPDF = same Novel Excel zip
		up_epdf = invokeurl
		[
			url :"https://www.zohoapis.in/crm/v8/files"
			type :POST
			files:excel_file
			connection:"zohocrmall"
		];
		info "NOVEL - Uploads for account " + m.get("accno") + " -> report: " + up_report + " - epdf: " + up_epdf;
		if(up_report != null && up_report.containKey("data"))
		{
			ba.put("Perfios_Report",{{"file_id":up_report.get("data").get(0).get("details").get("id")}});
		}
		if(up_epdf != null && up_epdf.containKey("data"))
		{
			ba.put("Perfios_EPDF",{{"file_id":up_epdf.get("data").get(0).get("details").get("id")}});
		}
		new_rows.add(ba);
	}
	info "NOVEL - New rows: " + new_rows.size() + " - Failed banks: " + failed_banks.size();
	// =====================================================
	// Save - read fresh, keep old rows, add new rows, one save
	// =====================================================
	fresh = zoho.crm.getRecordById("Bank_Details",id);
	add_bank_fresh = ifnull(fresh.get("Additional_banks_details"),List());
	bank_subform = List();
	bank_subform.addAll(ifnull(fresh.get("Bank_account"),List()));
	for each  a in add_bank_fresh
	{
		if(ifnull(a.get("Transaction_ID"),"") == transaction_id && ifnull(a.get("Status"),"").equalsIgnoreCase("Link Generated"))
		{
			a.put("Status","Completed");
			if(ifnull(a.get("DMS_ID"),"") == "" && dms_id != "")
			{
				a.put("DMS_ID",dms_id);
				if(zfs_fileid != "" && zfs_fileid != "zfs_resp failed" && !isNull(zfs_fileid))
				{
					a.put("Account_Analysis",{{"file_id":zfs_fileid}});
				}
			}
		}
	}
	updateMap.put("Additional_banks_details",add_bank_fresh);
	if(new_rows.size() > 0)
	{
		bank_subform.addAll(new_rows);
		updateMap.put("Bank_Details_Completed",true);
		updateMap.put("Show_bank_subform",true);
		updateMap.put("Bank_account",bank_subform);
		updateMap.put("FCU_Retrigger",true);
	}
	if(failed_flag || pan_failed)
	{
		updateMap.put("Bank_Failed",true);
		updateMap.put("Failed_Banks",failed_banks);
	}
	updateMap.put("Show_Widget",false);
	info "NOVEL - Save payload: " + updateMap;
	upd_resp = zoho.crm.updateRecord("Bank_Details",id,updateMap);
	info "NOVEL - Save response: " + upd_resp;
	if(upd_resp == null || upd_resp.containKey("code"))
	{
		return "Bank details could not be saved. Please try again or contact support.";
	}
	// ----- After save: totals (the months check runs by the Bank Details workflow when the record is edited, same as Perfios) -----
	try 
	{
		info "NOVEL - Totals update: " + standalone.CSEL_BANK_TOTALS_UPDATE(id);
	}
	catch (e)
	{
		info "NOVEL - Post-save error: " + e;
	}
	// Request is consumed only after the save worked
	info zoho.crm.updateRecord("Logger",link_id,{"Perfios_Status":"Completed"});
	if(ifnull(return_message,"") != "")
	{
		if(return_message.contains("Pan no. as per Novel is"))
		{
			// same dialog as Perfios
			response = Map();
			response.put("acknowledgment",{"title":"Case Rejected","content":return_message,"onAccept":{"action_type":"invoke_url","properties":{"url":case_rejected_url,"open_in":"same window"}}});
			return response.toString();
		}
		return return_message;
	}
	if(new_rows.size() == 0)
	{
		return "Novel report processed, but no account could be added. Please check the failed banks.";
	}
	// the account number the user entered must be one of the accounts Novel returned (same check as Perfios)
	try 
	{
		bank_after = zoho.crm.getRecordById("Bank_Details",id);
		entered_found = false;
		entered_matched = false;
		for each  sldl in ifnull(bank_after.get("SL_DP_Data"),List())
		{
			if(ifnull(sldl.get("Transaction_ID"),"").toString() == transaction_id.toString())
			{
				entered_found = true;
				entered_acc = ifnull(sldl.get("Bank_Account_Number"),"").toString().trim();
				for each  novel_acc in bank_list
				{
					novel_acc_no = ifnull(novel_acc.get("accno"),"").toString().trim();
					if(novel_acc_no == entered_acc)
					{
						entered_matched = true;
					}
					else if((novel_acc_no.contains("X") || novel_acc_no.contains("x") || novel_acc_no.contains("*")) && novel_acc_no.length() >= 4 && entered_acc.length() >= 4 && novel_acc_no.subString(novel_acc_no.length() - 4) == entered_acc.subString(entered_acc.length() - 4))
					{
						// Account Aggregator can return a masked number (XXXXXX1234): the last 4 digits must match
						entered_matched = true;
					}
				}
			}
		}
		if(entered_found && !entered_matched)
		{
			return "Account number mismatch between Novel API Response and the user input value.";
		}
	}
	catch (e)
	{
		info "NOVEL - Account number check error: " + e;
	}
	return "Bank Details populated successfully";
}
catch (e)
{
	emp = Map();
	emp.put("details",dmp);
	emp.put("error_message",e.toString());
	emp.put("action_performed","CSEL_NOVEL_REPORT_FETCH");
	info standalone.Client_Script_Assistance_Error_message(emp,"Error_Message");
}
return "";
}

